{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "schedule:weekly"],
  timezone: "Europe/Zurich",

  // pr.yml rejects any commit subject that isn't a Conventional Commit, and
  // main requires signed commits: platform commits are signed by GitHub.
  semanticCommits: "enabled",
  platformCommit: "enabled",
  // The ruleset allows squash too, but only a merge commit keeps the signed
  // commits intact.
  automergeStrategy: "merge-commit",

  // A version is proposed only once it is three days old, so a compromised
  // release has time to be noticed and pulled first. Fixes raised from
  // vulnerability alerts skip the wait.
  minimumReleaseAge: "3 days",

  packageRules: [
    // cgr.dev publishes no release timestamps and `latest` has no version to
    // age against, so the hold would keep the digest where it is for good.
    {
      matchDepNames: ["cgr.dev/chainguard/static"],
      minimumReleaseAge: null,
    },
    // Go releases are where stdlib security fixes arrive, and vulnerability
    // alerts don't cover the go directive, so the hold would only delay them.
    {
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      minimumReleaseAge: null,
    },
    // Root module only: docs/go.mod is a Hugo module with no Go code, so tidy
    // would see the theme as unused and delete it.
    {
      matchManagers: ["gomod"],
      matchFileNames: ["go.mod"],
      postUpdateOptions: ["gomodTidy"],
    },
    // Restricting the group to minors and patches is what makes majors arrive
    // one per PR, to be read rather than skimmed.
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "go modules",
    },
    // The tool block. Renovate sees those modules as indirect requirements,
    // and every other indirect one stays disabled, so this matches exactly
    // the tools, including any added later.
    {
      matchManagers: ["gomod"],
      matchFileNames: ["go.mod"],
      matchDepTypes: ["indirect"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "go tools",
    },
    // Unlike the module group, this one takes majors: an action major is
    // near-always a Node bump.
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      matchManagers: ["custom.regex"],
      groupName: "build tools",
    },
    // The docs theme is the docs module's only requirement, and Hugo modules
    // mark it indirect because nothing imports it, which Renovate skips by
    // default. It travels with Hugo because a theme release can raise the
    // Hugo it needs.
    {
      matchFileNames: ["docs/go.mod"],
      matchDepTypes: ["indirect"],
      enabled: true,
      groupName: "build tools",
    },
    // Renovate leaves the go directive alone by default. Raising it is how a
    // stdlib security fix reaches the release.
    {
      matchManagers: ["gomod"],
      matchDepTypes: ["golang"],
      matchDepNames: ["go"],
      rangeStrategy: "bump",
    },
    // golangci-lint has to be able to read the export data of the Go that
    // setup-go installs, and even a Go patch release can change it. Moving
    // them in one PR means the lint failure shows up where the cause is.
    {
      matchDepNames: ["go", "golangci/golangci-lint"],
      groupName: "go toolchain",
    },

    // Automerge covers only what a pull request's checks run in full. A
    // failing check leaves the PR open, and nothing ships without a signed
    // tag. Everything else stays manual: runtime modules because the tests
    // use fakes rather than real calendar servers, the docs theme because it
    // needs looking at, and anything that only release.yml or a schedule runs
    // because it would first fail in the middle of a release. A PR merges
    // only when every update in it qualifies.
    {
      matchManagers: ["gomod"],
      matchFileNames: ["go.mod"],
      matchDepTypes: ["indirect"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    // Go patch releases are where stdlib security fixes come from.
    {
      matchDepNames: ["go"],
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
    {
      matchDepNames: ["golangci/golangci-lint"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    // An allowlist of the actions ci.yml and codeql.yml run, so a newly added
    // action starts out manual. Digest updates stay manual: a new commit
    // under an unchanged version means the tag was moved, which is how a
    // hijacked action spreads, and the release-age hold can't see it because
    // it ages against the tag's original commit date.
    {
      matchManagers: ["github-actions"],
      matchDepNames: [
        "actions/checkout",
        "actions/setup-go",
        "golangci/golangci-lint-action",
        "github/codeql-action",
      ],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
  ],

  customManagers: [
    // A pin Renovate wouldn't otherwise see carries an annotation on the line
    // above it:  # renovate: datasource=<datasource> depName=<name>
    // plus extractVersion=<regex> where the file wants the version without
    // the tag's leading v.
    // An action's `with: version:` needs none; the github-actions manager
    // reads those itself, and an annotation there would extract it twice.
    {
      customType: "regex",
      managerFilePatterns: [
        "/^Taskfile\\.yml$/",
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^docs/hugo\\.yaml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n[^\\n]*?(?:version: |min: \"|@)(?<currentValue>v?\\d[^\\s\"]*)",
      ],
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.goreleaser\\.yaml$/"],
      matchStrings: [
        "base_image: (?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      datasourceTemplate: "docker",
      autoReplaceStringTemplate: "base_image: {{depName}}:{{newValue}}@{{newDigest}}",
    },
  ],
}
