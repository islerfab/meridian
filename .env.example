# Copy to .env (gitignored) and fill in. Used by hack/spike-expand (mer-pdn).
# Infomaniak: use your account email + an application password
# (Manager → Security → Application passwords; required with 2FA).
MERIDIAN_SPIKE_USER=you@example.com
MERIDIAN_SPIKE_PASS=app-password
# Optional, defaults to https://sync.infomaniak.com
#MERIDIAN_SPIKE_ENDPOINT=https://sync.infomaniak.com

# Google OAuth client (Cloud Console → Credentials → OAuth client, Desktop app).
# Consent screen must be PUBLISHED (Testing mode = refresh tokens die in 7 days).
MERIDIAN_GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
MERIDIAN_GOOGLE_CLIENT_SECRET="..."
# Written by `meridian oauth --write-env .env` — do not fill by hand.
#MERIDIAN_GOOGLE_REFRESH_TOKEN=
# Test calendar ID (Calendar settings → Integrate calendar), not secret.
MERIDIAN_GOOGLE_CALENDAR_ID="...@group.calendar.google.com"
