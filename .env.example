# Copy to .env (gitignored) and fill in. Used by hack/spike-expand (mer-pdn).
# Infomaniak: use your account email + an application password
# (Manager → Security → Application passwords; required with 2FA).
MERIDIAN_SPIKE_USER=you@example.com
MERIDIAN_SPIKE_PASS=app-password
# Optional, defaults to https://sync.infomaniak.com
#MERIDIAN_SPIKE_ENDPOINT=https://sync.infomaniak.com
